# ==============================================================================
# Chatapp Environment Configuration (.env)
# ==============================================================================

# Application & Environment
APP_NAME=chatapp
ENV=development
DEBUG=false

# Subdomains & Hostnames (via Cloudflare Tunnel / Reverse Proxy)
CHAT_HOSTNAME=chat.vajapravin.me
API_HOSTNAME=api.vajapravin.me
MQTT_HOSTNAME=mqtt.vajapravin.me
S3_HOSTNAME=s3.vajapravin.me

# Host Port Mappings (Ingress from external Cloudflare Tunnel or reverse proxy)
WEB_PORT=3001
API_PORT=8001
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001
POSTGRES_PORT=5435
REDIS_PORT=6380
NATS_PORT=4223

# Postgres 16 Database
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp_secret_change_in_production
DATABASE_URL=postgresql+asyncpg://chatapp:chatapp_secret_change_in_production@postgres:5435/chatapp

# Redis 7 Cache & Rate Limiting
REDIS_URL=redis://redis:6380/0

# NATS JetStream Event Bus
NATS_URL=nats://nats:4222

# Security & JWT Tokens
JWT_SECRET_KEY=generate-a-strong-64-char-secret-string-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Verification Provider: 'console' (dev logs) or 'email' (SMTP)
OTP_PROVIDER=console
OTP_EXPIRE_SECONDS=300

# SMTP Configuration (required only when OTP_PROVIDER=email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vajapravin.me
SMTP_USE_TLS=false
SMTP_STARTTLS=true

# S3-compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT=http://host.docker.internal:9002
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=chatapp-media

# Optional WebRTC TURN (Phase 5)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
